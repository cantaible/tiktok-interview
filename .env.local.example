# Environment Variables
# Copy this file to .env.local and fill in your actual values

# 阿里云 DashScope API 配置
# 获取方式：https://help.aliyun.com/zh/model-studio/getting-started/first-api-call-to-qwen
# 1. 登录阿里云控制台：https://dashscope.console.aliyun.com/
# 2. 创建 API-KEY
# 3. 复制 API Key 并填入下方
DASHSCOPE_API_KEY=your_api_key_here

# 可选：指定模型（默认为 qwen-plus）
# 可选值：qwen-turbo, qwen-plus, qwen-max, qwen-max-longcontext
# DASHSCOPE_MODEL=qwen-plus
